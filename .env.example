NODE_ENV=development
PORT=3000

DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Auth ---
# Generate with: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth — the callback URL must be registered in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
FRONTEND_OAUTH_REDIRECT=http://localhost:4200/auth/google/callback

# Comma-separated list of emails allowed to sign in with Google
AUTH_ALLOWED_EMAILS=

# Super admin seeded by: npm run db:seed:super-admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=
